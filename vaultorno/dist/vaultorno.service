# The daemon (design doc §3, §14). Its listening socket arrives as standard
# input; a release build refuses to start any other way.
[Unit]
Description=vaultorno daemon, a locker room for disposable secrets
Requires=vaultorno.socket vaultorno_inspect.socket
After=vaultorno.socket vaultorno_inspect.socket

[Service]
ExecStart=/usr/bin/vaultorno daemon
StandardInput=socket
StandardOutput=journal
StandardError=journal
User=vaultorno
Group=vaultorno
StateDirectory=vaultorno
StateDirectoryMode=0700
LoadCredentialEncrypted=master_key:/var/lib/vaultorno/master_key.cred
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
# Callers are reached through pidfds and the inspector, never /proc.
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryDenyWriteExecute=yes
LimitCORE=0
